---
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import "../styles/global.css";
import ProjectColors from "../components/ProjectColors.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { absolute, SITE } from "../site.ts";

interface Props {
  title: string;
  description?: string | undefined;
  /** The page's address, e.g. "/" or "/guide/first/". Omit for pages that aren't resources (404). */
  path?: string;
  /** The address of the page's Markdown twin. */
  markdownPath?: string;
  /** Front pages lay out their own full-width sections; other pages get one column. */
  bleed?: boolean;
  noindex?: boolean;
}

const { title, description, path, markdownPath, bleed = false, noindex = false } = Astro.props;
const { project } = SITE;
const fullTitle = title === SITE.title ? `${title}: ${project.job}` : `${title} · ${SITE.title}`;

---

<!doctype html>
<html lang={SITE.language} class={`p-${project.id}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {path && <link rel="canonical" href={absolute(path)} />}
    {markdownPath && <link rel="alternate" type="text/markdown" href={absolute(markdownPath)} title={`${title} (Markdown)`} />}
    <link rel="help" type="text/plain" href={absolute("/llms.txt")} title="llms.txt" />
    <link rel="license" href={SITE.license.url} title={SITE.license.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    {path && <meta property="og:url" content={absolute(path)} />}
    <meta property="og:type" content="website" />
    <ProjectColors />
  </head>
  <body class="bg-ground text-ink">
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader path={path} />
    <main id="main" class:list={[{ "wrap page": !bleed }]}>
      <slot />
    </main>
    <SiteFooter markdownPath={markdownPath} />
  </body>
</html>

<style>
  .page {
    padding-block: 2.5rem 4rem;
  }
</style>
