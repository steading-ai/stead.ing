---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import { getDocs, type LoadedDoc } from "../lib/content.ts";
import { navigation } from "../lib/docs.ts";
import Base from "../layouts/Base.astro";
import { SITE } from "../site.ts";

export const getStaticPaths = (async () => {
  const docs = await getDocs();
  return docs.map((doc) => ({ params: { slug: doc.path.slice(1, -1) }, props: { doc, docs } }));
}) satisfies GetStaticPaths;

interface Props {
  doc: LoadedDoc;
  docs: LoadedDoc[];
}

const { doc, docs } = Astro.props;
const { Content } = await render(doc.entry);
const nav = navigation(docs);
---

<Base title={doc.title} description={doc.data.description} path={doc.path} markdownPath={doc.markdown} wide>
  <div class="grid gap-8 lg:grid-cols-[14rem_minmax(0,1fr)]">
    <nav aria-label="Pages" class="text-sm lg:order-first">
      {
        nav.map((group) => (
          <div class="mb-4">
            {group.label && <p class="mb-1 font-mono font-semibold">{group.label}</p>}
            <ul class="space-y-1">
              {group.docs.map((entry) => (
                <li>
                  <a href={entry.path} aria-current={entry.path === doc.path ? "page" : undefined}>
                    {entry.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
    <article class="order-first min-w-0 lg:order-none">
      <div class="prose max-w-prose">
        {!doc.hasHeading && <h1>{doc.title}</h1>}
        <Content />
      </div>
      {
        SITE.editBase && (
          <p class="mt-8 text-sm">
            <a href={`${SITE.editBase}/${doc.file}`}>Edit this page</a>
          </p>
        )
      }
    </article>
  </div>
</Base>

<style>
  a[aria-current="page"] {
    font-weight: 600;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--accent);
  }
</style>
