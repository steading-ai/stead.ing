---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import { getPages, type LoadedDoc } from "../lib/content.ts";
import type { NavGroup } from "../lib/docs.ts";
import Base from "../layouts/Base.astro";
import { SITE } from "../site.ts";

export const getStaticPaths = (async () => {
  const { nav, docs } = await getPages();
  return docs.map((doc) => ({ params: { slug: doc.path.slice(1, -1) }, props: { doc, nav } }));
}) satisfies GetStaticPaths;

interface Props {
  doc: LoadedDoc;
  nav: NavGroup[];
}

const { doc, nav } = Astro.props;
const Content = doc.entry ? (await render(doc.entry)).Content : undefined;
const here = (path: string) => (path === doc.path ? "page" : undefined);
---

<Base title={doc.title} description={doc.data.description} path={doc.path} markdownPath={doc.markdown}>
  <div class="grid gap-10 lg:grid-cols-[16rem_minmax(0,1fr)]">
    <nav aria-label="Pages" class="pages lg:order-first">
      {
        nav.map((group) => (
          <div class="group">
            {group.index && (
              <a class="folder" href={group.index.path} aria-current={here(group.index.path)}>
                {group.label}
              </a>
            )}
            <ul>
              {group.docs.map((entry) => (
                <li>
                  <a href={entry.path} aria-current={here(entry.path)}>
                    {entry.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
    <article class="order-first min-w-0 lg:order-none">
      <div class="prose max-w-prose">
        {!doc.hasHeading && <h1>{doc.title}</h1>}
        {Content && <Content />}
        {
          doc.lists && (
            <ul>
              {doc.lists.map((page) => (
                <li>
                  <a href={page.path}>{page.title}</a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      {
        SITE.editBase && doc.file && (
          <p class="mt-8 text-sm">
            <a href={`${SITE.editBase}/${doc.file}`}>Edit this page</a>
          </p>
        )
      }
    </article>
  </div>
</Base>

<style>
  .pages {
    font-size: 0.95rem;
  }
  .group + .group {
    margin-top: 1.25rem;
  }
  .pages a {
    display: block;
    padding: 0.2rem 0 0.2rem 0.75rem;
    border-left: 3px solid var(--line);
    text-decoration: none;
  }
  /* A folder's name is its own page, and heads the pages filed under it. */
  .pages .folder {
    padding-left: 0;
    border-left: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .pages a:hover {
    border-left-color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  /* The page you are on, marked in the site's color and in weight. */
  .pages a[aria-current="page"] {
    border-left-color: var(--accent);
    font-weight: 600;
  }
  .pages .folder[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
  }
</style>
