---
// A workbench for comparing designs before one is chosen. Built only when
// STEADING_LAB is set, so it never reaches a published site.
import type { GetStaticPaths } from "astro";
import DayStrip from "../../components/motifs/DayStrip.astro";
import Receipt from "../../components/motifs/Receipt.astro";
import RunSheet from "../../components/motifs/RunSheet.astro";
import PromptBox from "../../components/PromptBox.astro";
import { getLanding } from "../../lib/content.ts";
import Base from "../../layouts/Base.astro";

export const getStaticPaths = (() => (process.env.STEADING_LAB ? [{ params: { page: "heroes" } }] : [])) satisfies GetStaticPaths;

const landing = await getLanding();
const sentences = landing.headline.split(/(?<=\.)\s+/);
const variations = [
  {
    id: "receipt",
    name: "1. The receipt",
    idea: "One finished task, itemised: each step, the project that took it, what a program checked, and what it cost. Your lines are the only ember. It includes the moment the agent says done and the check says otherwise.",
    shape: "split",
  },
  {
    id: "sheet",
    name: "2. The run sheet",
    idea: "A night's work, one row per task and one square per step. Solid means a program checked it. The round ember marks are the only places you were needed.",
    shape: "wide",
  },
  {
    id: "day",
    name: "3. One day",
    idea: "Midnight to midnight. Your rail is nearly empty, and the work runs on underneath it through the night.",
    shape: "wide",
  },
] as const;
---

<Base title="Hero variations" noindex bleed>
  <div class="wrap intro">
    <h1 class="title">Hero variations</h1>
    <p class="measure mt-2 text-muted">
      Three ways to open the page with the product's own record of work, each in a full hero. The step names are mill's real
      ones. The tasks, times and costs are placeholders, to be replaced by a real run before anything ships.
    </p>
  </div>
  {
    variations.map((variation) => (
      <section class="variation" aria-labelledby={`v-${variation.id}`}>
        <div class="wrap">
          <p class="caption">
            <strong id={`v-${variation.id}`}>{variation.name}</strong> {variation.idea}
          </p>
          <div class={`hero ${variation.shape}`}>
            <div class="text">
              <h2 class="display">
                {sentences.map((sentence) => (
                  <span>{sentence} </span>
                ))}
              </h2>
              <div class="words">
                <p class="lead measure">{landing.summary}</p>
                <PromptBox prompt={landing.prompt} id={`prompt-${variation.id}`} />
              </div>
            </div>
            <div class="picture">
              {variation.id === "receipt" && <Receipt />}
              {variation.id === "sheet" && <RunSheet />}
              {variation.id === "day" && <DayStrip />}
            </div>
          </div>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .intro {
    padding-block: 1.5rem;
  }
  .variation {
    padding-block: 2rem 4.5rem;
    border-top: 1px solid var(--line);
  }
  .caption {
    max-width: 70ch;
    margin-bottom: 2.5rem;
    padding: 0.6rem 0.9rem;
    border-left: 4px solid var(--ember);
    background: var(--surface);
    font-size: 0.95rem;
  }
  .hero,
  .text,
  .words {
    display: grid;
    gap: 1.5rem;
  }
  .hero {
    gap: 2rem 3.5rem;
  }
  /* A grid item is as wide as its widest content unless told otherwise. */
  .hero > *,
  .text > *,
  .words > * {
    min-width: 0;
  }
  .display span {
    display: block;
  }
  @media (min-width: 72rem) {
    /* The headline on one line across the page. */
    .display span {
      display: inline;
    }
    /* Split: the words on the left, the record beside them. */
    .split {
      grid-template-columns: minmax(0, 1fr) 34rem;
      align-items: start;
    }
    .split .text {
      display: contents;
    }
    .split .display {
      grid-column: 1 / -1;
    }
    .split .words {
      padding-top: 1rem;
    }
    /* Wide: the first step beside the summary, the record across the page beneath. */
    .wide .words {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3.5rem;
      align-items: start;
    }
  }
</style>
