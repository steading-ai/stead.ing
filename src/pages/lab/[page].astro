---
// A workbench for comparing designs before one is chosen. Built only when
// STEADING_LAB is set, so it never reaches a published site.
import type { GetStaticPaths } from "astro";
import Timeline from "../../components/motifs/Timeline.astro";
import PromptBox from "../../components/PromptBox.astro";
import { getLanding } from "../../lib/content.ts";
import Base from "../../layouts/Base.astro";

export const getStaticPaths = (() => (process.env.STEADING_LAB ? [{ params: { page: "heroes" } }] : [])) satisfies GetStaticPaths;

const landing = await getLanding();
const sentences = landing.headline.split(/(?<=\.)\s+/);
const variations = [
  {
    id: "muted",
    name: "1. Muted",
    idea: "The whole day in the text color. A project's color appears only on the story happening now, and on whatever you point at, so the Copy button is the brightest thing on the page.",
    layout: "beside",
    view: { pxPerHour: 130, backlog: false, threads: true, speed: 1 / 7, tone: "muted" },
  },
  {
    id: "thin",
    name: "2. Thin",
    idea: "The same strip at about two thirds the height and half the speed, kept in color.",
    layout: "beside",
    view: { pxPerHour: 130, backlog: false, threads: true, speed: 1 / 14, compact: true },
  },
  {
    id: "first",
    name: "3. The prompt first",
    idea: "The prompt box runs the full width under the headline, at a larger size, and the day sits beneath it, thin and muted, as what comes after.",
    layout: "first",
    view: { pxPerHour: 130, backlog: false, threads: true, speed: 1 / 10, tone: "muted", compact: true },
  },
  {
    id: "still",
    name: "4. Still",
    idea: "In color, but nothing moves until you press Play. Pointing at an event still explains it.",
    layout: "beside",
    view: { pxPerHour: 130, backlog: false, threads: true, speed: 1 / 7, autoplay: false },
  },
] as const;
---

<Base title="Hero variations" noindex bleed>
  <div class="wrap intro">
    <h1 class="title">Hero variations</h1>
    <p class="measure mt-2 text-muted">
      Four quieter takes on the hub's hero, so the day strip supports "Paste this into your agent" instead of competing
      with it. The hub itself has the full-color strip for now.
    </p>
  </div>
  {
    variations.map((variation) => (
      <section class="variation" aria-labelledby={`v-${variation.id}`}>
        <div class="wrap">
          <p class="caption">
            <strong id={`v-${variation.id}`}>{variation.name}</strong> {variation.idea}
          </p>
          <div class={`hero ${variation.layout}`}>
            <div class="text">
              <h2 class="display">
                {sentences.map((sentence) => (
                  <span>{sentence} </span>
                ))}
              </h2>
              <div class="words">
                <p class="lead measure">{landing.summary}</p>
                <PromptBox prompt={landing.prompt} id={`prompt-${variation.id}`} />
              </div>
            </div>
            <div class="picture">
              <Timeline id={variation.id} view={variation.view} />
            </div>
          </div>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .intro {
    padding-block: 1.5rem;
  }
  .variation {
    padding-block: 2rem 4.5rem;
    border-top: 1px solid var(--line);
  }
  .caption {
    max-width: 70ch;
    margin-bottom: 2.5rem;
    padding: 0.6rem 0.9rem;
    border-left: 4px solid var(--ember);
    background: var(--surface);
    font-size: 0.95rem;
  }
  .hero,
  .text,
  .words {
    display: grid;
    gap: 1.5rem;
  }
  .hero {
    gap: 2rem 3.5rem;
  }
  /* A grid item is as wide as its widest content unless told otherwise. */
  .hero > *,
  .text > *,
  .words > * {
    min-width: 0;
  }
  .display span {
    display: block;
  }
  @media (min-width: 72rem) {
    /* The headline on one line across the page. */
    .display span {
      display: inline;
    }
    /* Beside: the first step next to the summary, the day across the page beneath. */
    .beside .words {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3.5rem;
      align-items: start;
    }
  }
  /* The prompt first: it takes the full width, at a size that says it is the point. */
  .first .words :global(.prompt) {
    padding: 1.25rem 1.4rem;
  }
  .first .words :global(.prompt pre) {
    font-size: 1.05rem;
  }
</style>
