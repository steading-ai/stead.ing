---
import HubHome from "../components/HubHome.astro";
import ProjectHome from "../components/ProjectHome.astro";
import { getLanding } from "../lib/content.ts";
import Base from "../layouts/Base.astro";
import { SITE } from "../site.ts";

const landing = await getLanding();
---

<Base title={SITE.title} description={landing.summary} path="/" markdownPath="/index.md" bleed>
  {SITE.isHub ? <HubHome landing={landing} /> : <ProjectHome landing={landing} docs={SITE.pages.length > 0} />}
</Base>
