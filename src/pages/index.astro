---
import HubHome from "../components/HubHome.astro";
import ProjectHome from "../components/ProjectHome.astro";
import { getDocs, getLanding } from "../lib/content.ts";
import { navigation } from "../lib/docs.ts";
import Base from "../layouts/Base.astro";
import { SITE } from "../site.ts";

const landing = await getLanding();
const nav = navigation(await getDocs());
---

<Base title={SITE.title} description={landing.summary} path="/" markdownPath="/index.md" wide>
  {SITE.isHub ? <HubHome landing={landing} /> : <ProjectHome landing={landing} nav={nav} />}
</Base>
