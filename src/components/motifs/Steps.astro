---
// Everything that has to go through you, as five steps side by side, each a
// small drawing above its words, joined by a line. The last one, the tangle
// you come back to, is the only one drawn in ember.
import { ICONS, STEPS } from "../../lib/icons.ts";

// Every step's words break before the last one, so the five read as a row of the same shape.
const lines = (text: string) => [text.slice(0, text.lastIndexOf(" ")), text.slice(text.lastIndexOf(" ") + 1)];
---

<ol class="steps">
  {
    STEPS.map((step, index) => (
      <li class:list={[{ last: index === STEPS.length - 1 }]}>
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[step.icon]} />
        <span>
          {lines(step.text)[0]} <br />
          {lines(step.text)[1]}
        </span>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    --icon: 2.75rem;
    --join: 3rem;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
  }
  /* The drawing sits over the middle of its words, and the words break after the first. */
  li {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.6rem;
  }
  .icon {
    width: var(--icon);
    height: var(--icon);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon :global(.ray),
  .last .icon {
    stroke: var(--ember);
  }
  /* A line from each step to the next, across the gap between them. */
  li + li::before {
    content: "";
    position: absolute;
    top: calc(var(--icon) / 2);
    left: calc(var(--join) / -2);
    width: var(--join);
    border-top: 2px solid var(--line);
  }
  @media (max-width: 48rem) {
    .steps {
      --icon: 2.25rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem 1rem;
      font-size: 1rem;
    }
    li {
      grid-template-columns: auto minmax(0, 1fr);
      justify-items: start;
      align-items: center;
      gap: 0.7rem;
    }
    li br {
      display: none;
    }
    li + li::before {
      display: none;
    }
  }
</style>
