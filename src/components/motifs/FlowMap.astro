---
// The product map as a small machine. Each project is a card in its own color;
// what travels between them is marked on the line it travels, and moves along
// it. A project lights while it is busy. Solid lines and borders are what runs
// today; dashed ones are early, in design, or still to be joined up.
import { BURSTS, BUSY, CYCLE, during, EDGES, type EdgeId, head, KINDS, middle, NODES, OUTSIDE, type Sender, SIZE, STREAMS, travel, WORLD, YOU } from "../../lib/flow.ts";
import { LIGHT_BOX, LIGHTS } from "../../lib/mark.ts";
import { PROJECTS } from "../../projects.ts";
import { SITE } from "../../site.ts";

interface Props {
  /** Names this map, so several can share a page. */
  id: string;
}

const { id } = Astro.props;
const project = (name: string) => PROJECTS.find((candidate) => candidate.id === name);
// Every project on the map leads somewhere: to its own site once it has one, and to its entry on the hub until then.
const href = (name: string) => project(name)?.site ?? `${SITE.isHub ? "" : SITE.hub}#${name}`;
// A line, and what moves along it, wears the color of whoever sends it.
const by = (sender: Sender) => (sender === "you" || sender === "world" ? `by-${sender}` : `p-${sender}`);
const edges = Object.entries(EDGES) as [EdgeId, (typeof EDGES)[EdgeId]][];

const tokens = [
  ...BURSTS.flatMap((burst, index) =>
    Array.from({ length: burst.count }, (_, item) => ({
      by: by(EDGES[burst.edge].from),
      style: `offset-path:path('${EDGES[burst.edge].d}');animation:${id}-b${index} ${CYCLE}s linear ${(item * burst.gap).toFixed(2)}s infinite`,
    })),
  ),
  ...STREAMS.flatMap((stream, index) =>
    Array.from({ length: stream.count }, (_, item) => ({
      by: by(EDGES[stream.edge].from),
      style: `offset-path:path('${EDGES[stream.edge].d}');animation:${id}-s${index} ${stream.every}s linear ${((item * stream.every) / stream.count).toFixed(2)}s infinite`,
    })),
  ),
];

const keyframes = [
  ...BURSTS.map((burst, index) => travel(`${id}-b${index}`, burst.from, burst.takes)),
  ...STREAMS.map((stream, index) => {
    const arrives = ((stream.takes / stream.every) * 100).toFixed(1);
    return `@keyframes ${id}-s${index}{0%{offset-distance:0%;opacity:1}${arrives}%{offset-distance:100%;opacity:1}${(Number(arrives) + 0.5).toFixed(1)}%,100%{offset-distance:100%;opacity:0}}`;
  }),
  ...Object.entries(BUSY).map(([node, spans]) => during(`${id}-n-${node}`, spans)),
].join("");
const loop = (name: string) => `animation:${id}-${name} ${CYCLE}s linear infinite`;
---

<style is:inline set:html={keyframes}></style>

<figure class="flow">
  <!-- On a narrow screen the map scrolls sideways, so it has to be reachable by keyboard. -->
  <div class="scroll" tabindex="0" role="region" aria-label="Product map">
    <svg viewBox={`0 0 ${SIZE.width} ${SIZE.height}`} role="group" aria-labelledby={`${id}-title`} aria-describedby={`${id}-about`}>
      <title id={`${id}-title`}>How work moves through Steading</title>

      <g aria-hidden="true">
        {
          edges.map(([, edge]) => (
            <g class:list={["edge", by(edge.from), { planned: edge.planned }]}>
              <path class="line" d={edge.d} />
              <path class="head" d={head(edge.d)} />
            </g>
          ))
        }
      </g>

      <g class="source by-you">
        <circle class="dot" cx={YOU.x} cy={YOU.y} r="7"></circle>
        <text class="name" x="6" y={YOU.y - 18}>you</text>
        <text class="role" x="6" y={YOU.y + 24}>an idea</text>
      </g>
      <g class="source by-world">
        <circle class="ring" cx={WORLD.x} cy={WORLD.y} r="6"></circle>
        <text class="name" x="6" y={WORLD.y - 18}>the world</text>
        <text class="role" x="6" y={WORLD.y + 24}>updates, alerts</text>
      </g>
      <text class="role" x={OUTSIDE.x} y={OUTSIDE.y - 10}>
        <tspan x={OUTSIDE.x}>models,</tspan>
        <tspan x={OUTSIDE.x} dy="14">GitHub,</tspan>
        <tspan x={OUTSIDE.x} dy="14">APIs</tspan>
      </text>

      {
        NODES.map((node) => {
          const about = project(node.id);
          const inside = (
            <Fragment>
              <rect class:list={["box", { dashed: about && about.status !== "running" }]} x={node.x} y={node.y} width={node.w} height={node.h} rx="9" />
              {BUSY[node.id] && <rect class="lit" style={loop(`n-${node.id}`)} x={node.x} y={node.y} width={node.w} height={node.h} rx="9" />}
              {about ? (
                <svg class="project-mark" x={node.x + 10} y={node.y + node.h / 2 - 14} width="28" height="28" viewBox={LIGHT_BOX} set:html={LIGHTS[about.glyph]} />
              ) : (
                <rect class="shipped" x={node.x + 15} y={node.y + node.h / 2 - 9} width="18" height="18" />
              )}
              <text class="name" x={node.x + 46} y={node.y + 27}>
                {about ? node.id : "shipped"}
              </text>
              <text class="role" x={node.x + 46} y={node.y + 45}>
                {about ? about.kind : "your idea, merged"}
              </text>
              <text class="role" x={node.x + 46} y={node.y + 60}>
                {node.role}
              </text>
            </Fragment>
          );
          return about ? (
            <a href={href(node.id)} class={`node p-${node.id}`} data-project={node.id}>
              {inside}
            </a>
          ) : (
            <g class="node by-you">{inside}</g>
          );
        })
      }

      <g aria-hidden="true">
        {tokens.map((token) => <circle class:list={["token", token.by]} r="3.5" style={token.style} />)}
        {
          edges
            .filter(([, edge]) => edge.badge)
            .map(([, edge]) => {
              const [x, y] = middle(edge.d);
              return (
                <g class:list={["badge", by(edge.from)]} transform={`translate(${x} ${y})`}>
                  <circle r="10.5" />
                  <svg class="kind" x="-6.5" y="-6.5" width="13" height="13" viewBox="0 0 16 16" set:html={KINDS[edge.kind].icon} />
                </g>
              );
            })
        }
      </g>
    </svg>
  </div>
  <figcaption id={`${id}-about`} class="sr-only">
    You talk an idea through with thicket, which files it in skift as tasks; almanac is meant to file tasks too, when
    something in the world changes. Skift hands mill whatever is ready. Mill works each task inside a croft, which asks
    knowledge what it needs and sends its outside requests through the gateway. The work comes back checked, mill merges
    it, and knowledge indexes what was filed and finished. Skift and mill run every day; almanac and thicket are early;
    croft, the gateway and knowledge are in design.
  </figcaption>
</figure>

<style is:global>
  .flow .scroll {
    overflow-x: auto;
  }
  .flow .scroll > svg {
    display: block;
    width: 100%;
    min-width: 44rem;
    height: auto;
    font-family: var(--font-sans);
    fill: var(--ink);
  }
  .flow .by-you {
    --accent: var(--ember);
  }
  .flow .by-world {
    --accent: var(--muted);
  }
  .flow .edge .line {
    fill: none;
    stroke: color-mix(in srgb, var(--accent) 55%, var(--line));
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .flow .edge.planned .line {
    stroke-dasharray: 5 4;
  }
  .flow .edge .head {
    fill: color-mix(in srgb, var(--accent) 55%, var(--line));
  }
  /* A card in the project's own color: a wash of it inside, more of it on the border. */
  .flow .box {
    fill: color-mix(in srgb, var(--accent) 7%, var(--surface));
    stroke: color-mix(in srgb, var(--accent) 60%, var(--line));
    stroke-width: 1.5;
  }
  .flow .box.dashed {
    stroke-dasharray: 5 4;
  }
  /* A project is a link: it says so when pointed at or reached by keyboard. */
  .flow a.node {
    text-decoration: none;
  }
  .flow a.node:hover .box,
  .flow a.node:focus-visible .box {
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-dasharray: none;
  }
  /* A project lights in its own color while it is busy, and goes quiet again. */
  .flow .lit {
    fill: color-mix(in srgb, var(--accent) 16%, transparent);
    stroke: var(--accent);
    stroke-width: 2;
    opacity: 0;
  }
  .flow .shipped {
    fill: none;
    stroke: var(--ember);
    stroke-width: 2.5;
  }
  .flow .source .dot {
    fill: var(--ember);
  }
  .flow .source .ring {
    fill: var(--ground);
    stroke: var(--muted);
    stroke-width: 2;
  }
  .flow .name {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 600;
  }
  .flow .source .name {
    font-size: 13px;
  }
  .flow .role {
    fill: var(--muted);
    font-size: 12px;
  }
  /* What a line carries, marked halfway along it. */
  .flow .badge circle {
    fill: var(--ground);
    stroke: color-mix(in srgb, var(--accent) 55%, var(--line));
    stroke-width: 1.5;
  }
  .flow .kind {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .flow .kind .dot {
    fill: var(--accent);
    stroke: none;
  }
  /* What moves: hidden until its turn, and never turned to face the way it is going. */
  .flow .token {
    fill: var(--accent);
    opacity: 0;
    offset-rotate: 0deg;
  }
</style>
