---
// One project on the product map: a labelled box that lights while the project
// is busy, or just its mark and name.
import { BUSY, CYCLE, type FlowNode } from "../../lib/flow.ts";
import { LIGHT_BOX, LIGHTS } from "../../lib/mark.ts";
import { PROJECTS } from "../../projects.ts";

interface Props {
  node: FlowNode;
  /** The map this node belongs to, which names its animations. */
  map: string;
  style: "boxes" | "marks";
}

const { node, map, style } = Astro.props;
const project = PROJECTS.find((candidate) => candidate.id === node.id);
// Solid for what runs every day, dashed for what is early or still in design.
const dashed = (project?.status ?? "running") !== "running";
const merged = node.id === "merged";
const loop = `animation:${map}-n-${node.id} ${CYCLE}s linear infinite`;
const glyph = LIGHTS[project?.glyph ?? "console"];
---

{
  style === "boxes" ? (
    <>
      <rect class:list={["box", { dashed }]} x={node.x} y={node.y} width={node.w} height={node.h} rx="6" />
      {BUSY[node.id] && <rect class="lit" style={loop} x={node.x} y={node.y} width={node.w} height={node.h} rx="6" />}
      {!merged && <svg class="project-mark" x={node.x + 8} y={node.y + 11} width="18" height="18" viewBox={LIGHT_BOX} set:html={glyph} />}
      <text class="name" x={node.x + (merged ? 12 : 32)} y={node.y + 17}>
        {merged ? node.role : node.id}
      </text>
      <text class="role" x={node.x + (merged ? 12 : 32)} y={node.y + 31}>
        {merged ? "your idea, shipped" : node.role}
      </text>
    </>
  ) : (
    <>
      {BUSY[node.id] && <circle class="halo" style={loop} cx={node.x + 20} cy={node.y + node.h / 2} r="19" />}
      {merged ? (
        <rect class="shipped" x={node.x + 10} y={node.y + node.h / 2 - 10} width="20" height="20" />
      ) : (
        <svg class="project-mark" x={node.x + 8} y={node.y + node.h / 2 - 12} width="24" height="24" viewBox={LIGHT_BOX} set:html={glyph} />
      )}
      <text class="name" x={node.x + 42} y={node.y + node.h / 2 + 5}>
        {merged ? "merged" : node.id}
      </text>
    </>
  )
}
