---
// Motif 2. A night's work as a sheet: one row per task, one square per step.
// A square is solid when a program checked the step, struck when the check
// failed and the step went back, and ember where the task waits on a person.
import { dollars, SHEET, type Square } from "../../lib/sample.ts";

const checked = SHEET.reduce((sum, task) => sum + task.squares.filter((square) => square === "held").length, 0);
const cents = SHEET.reduce((sum, task) => sum + task.cents, 0);
const waiting = SHEET.filter((task) => task.squares.includes("asks")).length;
const NAMES: Record<Square, string> = { held: "checked", back: "sent back", running: "running", asks: "needs you" };
const summary = (squares: Square[]) =>
  (Object.keys(NAMES) as Square[])
    .map((kind) => ({ kind, count: squares.filter((square) => square === kind).length }))
    .filter(({ count }) => count > 0)
    .map(({ kind, count }) => `${count} ${NAMES[kind]}`)
    .join(", ");
---

<figure class="sheet">
  <table>
    <caption>Last night, on the server that builds Steading</caption>
    <thead>
      <tr>
        <th scope="col" class="sr-only">Task</th>
        <th scope="col" class="sr-only">Title</th>
        <th scope="col" class="sr-only">Steps</th>
        <th scope="col" class="sr-only">Cost, or what it waits for</th>
      </tr>
    </thead>
    <tbody>
      {
        SHEET.map((task) => (
          <tr>
            <td class="ref">{task.ref}</td>
            <th scope="row">{task.title}</th>
            <td class="steps">
              <span class="squares" role="img" aria-label={summary(task.squares)}>
                {task.squares.map((square) => (
                  <span class={square} />
                ))}
              </span>
            </td>
            <td class="end">
              {task.needs ? <span class="needs">needs you: {task.needs}</span> : task.squares.includes("running") ? "running" : dollars(task.cents)}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <figcaption>
    <p class="totals">
      {SHEET.length} tasks, {checked} steps checked by a program, {dollars(cents)}, <span class="needs">{waiting} need you</span>
    </p>
    <ul class="key">
      <li><span class="squares"><span class="held"></span></span> a program checked it</li>
      <li><span class="squares"><span class="back"></span></span> the check failed, sent back</li>
      <li><span class="squares"><span class="running"></span></span> running</li>
      <li><span class="squares"><span class="asks"></span></span> needs you</li>
    </ul>
  </figcaption>
</figure>

<style>
  .sheet {
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  caption {
    padding-bottom: 0.6rem;
    color: var(--muted);
    font-size: 0.85rem;
    text-align: left;
  }
  tr {
    border-top: 1px solid var(--line);
  }
  tbody tr:last-child {
    border-bottom: 1px solid var(--line);
  }
  td,
  tbody th {
    padding: 0.55rem 0.75rem 0.55rem 0;
    font-weight: 400;
    text-align: left;
    vertical-align: middle;
  }
  .ref {
    width: 3.5rem;
    color: var(--muted);
  }
  tbody th {
    font-family: var(--font-sans);
    font-size: 1rem;
  }
  .end {
    padding-right: 0;
    text-align: right;
    white-space: nowrap;
  }
  .squares {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.28rem;
    vertical-align: middle;
  }
  .squares span {
    width: 0.85rem;
    height: 0.85rem;
    box-sizing: border-box;
  }
  .held {
    background: var(--ink);
  }
  /* Struck through: checked, and it did not hold. */
  .back {
    border: 1.5px solid var(--ink);
    background: linear-gradient(to top right, transparent 44%, var(--ink) 44% 56%, transparent 56%);
  }
  .running {
    border: 1.5px dashed var(--muted);
  }
  /* The light: the only ember, and the only round thing, on the sheet. */
  .squares .asks {
    border-radius: 50%;
    background: var(--ember);
  }
  .needs {
    font-weight: 600;
  }
  .totals {
    margin-top: 0.9rem;
    font-size: 1rem;
  }
  .totals .needs {
    text-decoration: underline;
    text-decoration-color: var(--ember);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.25em;
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
    margin-top: 0.6rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.85rem;
  }
  .key li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  /* On a phone a row stacks: the title, then its squares and where it stands. */
  @media (max-width: 47.99rem) {
    tbody tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      padding-block: 0.5rem;
    }
    .ref {
      display: none;
    }
    td,
    tbody th {
      padding: 0.1rem 0;
    }
    tbody th {
      grid-column: 1 / -1;
    }
  }
</style>
