---
// The top of every Steading site: the site's own mark and name (with the way
// back to Steading beside it, on a project's site), the Projects menu, and the
// few places most visitors want next.
import { getPages } from "../lib/content.ts";
import { STEADING } from "../projects.ts";
import { SITE } from "../site.ts";
import ProjectMark from "./ProjectMark.astro";
import ProjectsMenu from "./ProjectsMenu.astro";

interface Props {
  /** The address of the page being shown, to mark where the visitor is. */
  path?: string | undefined;
}

const { path } = Astro.props;
const { project } = SITE;
const { nav } = await getPages();
// The hub's few pages are named one by one. A project has many, so its docs are one link.
const pages = SITE.isHub ? (nav[0]?.items ?? []).slice(0, 3).map((item) => ({ href: item.doc.path, label: item.label })) : nav.length > 0 ? [{ href: SITE.mount, label: "Docs" }] : [];
const source = SITE.isHub ? "https://github.com/steading-ai" : project.repo;
const links = [...pages, ...(source ? [{ href: source, label: "GitHub" }] : [])];
const here = (href: string) => (path !== undefined && (href === path || (href === SITE.mount && !SITE.isHub && path.startsWith(SITE.mount))) ? "page" : undefined);
---

<header class="wrap site-header">
  <p class="crumbs">
    {
      !SITE.isHub && (
        <>
          <a href={STEADING.site} class="home p-steading">
            <ProjectMark glyph={STEADING.glyph} size={20} />
            steading
          </a>
          <span aria-hidden="true">/</span>
        </>
      )
    }
    <a href="/" class="wordmark">
      <ProjectMark glyph={project.glyph} size={36} />
      {project.name}
    </a>
  </p>
  <nav aria-label="Site">
    <ul>
      <li><ProjectsMenu /></li>
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={here(link.href)}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1rem;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    color: var(--muted);
  }
  .home {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    text-decoration: none;
  }
  .home:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
    font-size: 0.95rem;
  }
  nav li > a {
    text-decoration-color: transparent;
  }
  nav li > a:hover,
  nav li > a[aria-current="page"] {
    text-decoration-color: var(--accent);
  }
  @media (max-width: 47.99rem) {
    .wordmark {
      font-size: 1.25rem;
    }
    nav ul {
      font-size: 0.875rem;
      gap: 0.25rem 1.1rem;
    }
  }
</style>
