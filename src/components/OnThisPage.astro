---
import type { Heading } from "../lib/toc.ts";

interface Props {
  headings: Heading[];
  /** Beside the page, where a wide window has room; or folded above it, where a narrow one does not. */
  placement: "beside" | "above";
}

const { headings, placement } = Astro.props;
---

{
  placement === "beside" ? (
    <nav aria-label="On this page" class="toc beside" data-toc>
      <p class="heading">On this page</p>
      <ul>
        {headings.map((heading) => (
          <li class:list={{ sub: heading.depth === 3 }}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  ) : (
    <details class="toc above">
      <summary>On this page</summary>
      <nav aria-label="On this page" data-toc>
        <ul>
          {headings.map((heading) => (
            <li class:list={{ sub: heading.depth === 3 }}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )
}

<script>
  import { start } from "../lib/toc-client.ts";
  start(document);
</script>

<style>
  .toc {
    font-size: 0.875rem;
  }
  .heading,
  summary {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .heading {
    margin-bottom: 0.5rem;
  }
  /* Folded above the page, the list is one line until it is opened. */
  .above {
    margin-bottom: 1.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.375rem;
    background: var(--surface);
  }
  .above[open] summary {
    margin-bottom: 0.5rem;
  }
  a {
    display: block;
    padding: 0.2rem 0 0.2rem 0.75rem;
    border-left: 3px solid var(--line);
    color: var(--muted);
    text-decoration: none;
  }
  .sub a {
    padding-left: 1.5rem;
  }
  a:hover {
    border-left-color: var(--muted);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  /* The section being read, marked in the site's color and in weight, as the page is in the navigation. */
  a[aria-current="true"] {
    border-left-color: var(--accent);
    color: var(--ink);
    font-weight: 600;
  }
</style>
