---
// The opening of every front page: the headline, a summary, and the first
// step, which is always a prompt to paste into your own agent. Anything a site
// adds (an install command, a picture of the product at work) goes in the slot.
import PromptBox from "./PromptBox.astro";

interface Props {
  headline: string;
  summary: string;
  prompt: string;
}

const { headline, summary, prompt } = Astro.props;
const sentences = headline.split(/(?<=\.)\s+/);
---

<section class="hero wrap">
  <h1 class="display">{sentences.map((sentence) => <span>{sentence} </span>)}</h1>
  <p class="lead measure">{summary}</p>
  <PromptBox prompt={prompt} />
  <slot />
</section>

<style>
  .hero {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(1.25rem, 4vw, 2.5rem) clamp(2.5rem, 6vw, 4rem);
  }
  /* A grid item is as wide as its widest content unless told otherwise. What sits in the slot is another component's, so the rule has to reach past this one's own. */
  .hero > :global(*) {
    min-width: 0;
  }
  .display span {
    display: block;
  }
  /* The first step is the point of the page: it takes the full width, at a size that says so. */
  .hero :global(.prompt) {
    padding: 1.1rem 1.25rem;
  }
  .hero :global(.prompt pre) {
    font-size: 1.05rem;
  }
  .hero :global(.facts) {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .hero :global(.timeline) {
    margin-top: 1rem;
  }
  @media (min-width: 72rem) {
    /* A headline of two short sentences runs on one line across the page. */
    .display span {
      display: inline;
    }
  }
</style>
