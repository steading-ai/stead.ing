---
// A page that tells a story (`layout: story`): its title beside its first
// picture, then each `##` section as a wide band, with that section's picture
// beside it. The words are the page's own Markdown, so its Markdown twin reads
// the same; the pictures are decorative, drawn once for the light color scheme
// and once for the dark.
import { join } from "node:path";
import sharp from "sharp";
import type { LoadedDoc } from "../lib/content.ts";
import { SITE } from "../site.ts";

interface Props {
  doc: LoadedDoc;
}

const { doc } = Astro.props;
const html = doc.entry?.rendered?.html ?? "";
const data = doc.entry?.data;
const [top = "", ...rest] = html.split(/(?=<h2[\s>])/);
const strip = (fragment: string) => fragment.replace(/<[^>]+>/g, "").trim();
const sections = rest.map((part) => ({
  id: /<h2[^>]*\sid="([^"]+)"/.exec(part)?.[1] ?? "",
  title: strip(/<h2[^>]*>([\s\S]*?)<\/h2>/.exec(part)?.[1] ?? ""),
  html: part,
}));

/** A picture pair, by the ids the page's frontmatter names. A name that is not a picture beside the page stops the build. */
async function art(key: string) {
  const pair = data?.art?.[key];
  if (!pair) return undefined;
  const address = (file: string) => {
    const found = SITE.images.get(file);
    if (!found) throw new Error(`${doc.file}: art.${key} names ${file}, which is not a picture beside the page.`);
    return found;
  };
  const { width, height } = await sharp(join(SITE.contentDir, pair.light)).metadata();
  return { light: address(pair.light), dark: address(pair.dark), width, height };
}
for (const key of Object.keys(data?.art ?? {})) {
  if (key !== "top" && !sections.some((section) => section.id === key)) throw new Error(`${doc.file}: art.${key} names no section of the page.`);
}
const topArt = await art("top");
const parts = await Promise.all(sections.map(async (section) => ({ ...section, art: await art(section.id) })));
---

<div class="story">
  <header class="wrap top">
    <div class="words story-top">
      {data?.kicker && <p class="kicker">{data.kicker}</p>}
      <Fragment set:html={top} />
      {
        sections.length > 1 && (
          <nav aria-label="On this page" class="chips">
            <ul>
              {sections.map((section) => (
                <li>
                  <a href={`#${section.id}`}>{section.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
    {
      topArt && (
        <picture class="art">
          <source srcset={topArt.dark} media="(prefers-color-scheme: dark)" />
          <img src={topArt.light} alt="" width={topArt.width} height={topArt.height} decoding="async" />
        </picture>
      )
    }
  </header>

  {
    parts.map((part, index) => (
      <section class:list={["part", { "band-surface": index % 2 === 0 }]}>
        <div class:list={["wrap", "inner", { pictured: part.art, flip: part.art && index % 2 === 1 }]}>
          <div class="words prose" set:html={part.html} />
          {part.art && (
            <picture class="art">
              <source srcset={part.art.dark} media="(prefers-color-scheme: dark)" />
              <img src={part.art.light} alt="" width={part.art.width} height={part.art.height} loading="lazy" decoding="async" />
            </picture>
          )}
        </div>
      </section>
    ))
  }
</div>

<style>
  /* The title, the line under it, and the way into each section, beside the first picture. */
  .top {
    display: grid;
    gap: 2rem 3rem;
    align-items: center;
    padding-block: clamp(1.5rem, 4vh, 3rem);
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .top :global(h1) {
    margin-top: 0.5rem;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .top :global(h1 + p) {
    max-width: 52ch;
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 1.2rem;
    line-height: 1.5;
  }
  .chips ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }
  .chips a {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .chips a:hover {
    border-color: var(--accent);
  }

  /*
   * The pictures are pixel art: each is shown at its own size, or a whole
   * multiple of it, with hard edges, so every art pixel stays square.
   */
  .art {
    justify-self: center;
  }
  .art img {
    display: block;
    width: 100%;
    max-width: 512px;
    height: auto;
    image-rendering: pixelated;
  }

  .part {
    padding-block: clamp(2.5rem, 7vh, 4.5rem);
  }
  .inner {
    display: grid;
    gap: 2rem 4rem;
    align-items: center;
  }
  .words {
    min-width: 0;
  }
  @media (min-width: 64rem) {
    .top {
      grid-template-columns: minmax(0, 1fr) 512px;
    }
    .pictured {
      grid-template-columns: minmax(0, 1fr) 512px;
    }
    .flip {
      grid-template-columns: 512px minmax(0, 1fr);
    }
    .flip .art {
      order: -1;
    }
  }

  /* The words of a section: the site's prose, set a little larger, with a heading at the size of the hub's sections. */
  .prose {
    max-width: 68ch;
    font-size: 1.075rem;
  }
  /*
   * A section with no picture has the width of the page to itself: its words
   * keep their measure on the left, a quotation stands beside them, and steps
   * and tables take the whole width.
   */
  @media (min-width: 64rem) {
    .inner:not(.pictured) .prose {
      display: grid;
      grid-template-columns: minmax(0, 62ch) minmax(0, 1fr);
      column-gap: 4rem;
      max-width: none;
    }
    .inner:not(.pictured) .prose > :global(*) {
      grid-column: 1;
    }
    .inner:not(.pictured) .prose > :global(blockquote) {
      grid-column: 2;
      grid-row: 1 / span 6;
      align-self: start;
      margin-top: 4rem;
    }
    .inner:not(.pictured) .prose > :global(ol),
    .inner:not(.pictured) .prose > :global(.table-scroll),
    .inner:not(.pictured) .prose > :global(table) {
      grid-column: 1 / -1;
    }
    .inner:not(.pictured) .prose :global(ol) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .prose :global(h2) {
    margin-top: 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .prose :global(blockquote) {
    position: relative;
    margin-block: 1.75rem 0;
    padding: 1.1rem 1.4rem;
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: 0.6rem;
    background: var(--ground);
    font-style: normal;
    font-weight: 400;
  }
  .band-surface .prose :global(blockquote) {
    background: var(--ground);
  }
  .part:not(.band-surface) .prose :global(blockquote) {
    background: var(--surface);
  }
  .prose :global(blockquote p::before),
  .prose :global(blockquote p::after) {
    content: none;
  }
  .prose :global(blockquote p:first-child) {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    line-height: 1.5;
  }
  .prose :global(blockquote p:last-child) {
    color: var(--muted);
    font-size: 0.9rem;
  }
  /* A numbered list is a run of steps: each its own card, read in order. */
  .prose :global(ol) {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    counter-reset: step;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .prose :global(ol) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .prose :global(ol > li) {
    position: relative;
    margin: 0;
    padding: 0.8rem 1rem 0.8rem 3rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--ground);
    counter-increment: step;
  }
  .part:not(.band-surface) .prose :global(ol > li) {
    background: var(--surface);
  }
  .prose :global(ol > li::before) {
    content: counter(step);
    position: absolute;
    top: 0.8rem;
    left: 1rem;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-ember);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.4rem;
    text-align: center;
  }
  .prose :global(ul > li::marker) {
    color: var(--accent);
  }
  .prose :global(table) {
    font-size: 0.925rem;
  }
  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .prose :global(td:first-child) {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  /* On a narrow screen a table keeps a readable width and scrolls in its own frame, rather than breaking every word. */
  .prose :global(.table-scroll table) {
    min-width: 34rem;
  }
  @media (min-width: 64rem) {
    .prose :global(td:first-child) {
      white-space: nowrap;
    }
  }
  .prose :global(td:nth-child(2)) {
    font-weight: 600;
  }
</style>
