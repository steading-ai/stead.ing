---
// The map at the bottom of every page: every project, this site's pages, the
// parts of Steading that aren't a project, and the ways in for an agent.
import { getPages } from "../lib/content.ts";
import { PROJECTS, type Project, STEADING } from "../projects.ts";
import { HUB_PAGES, SITE } from "../site.ts";
import ProjectMark from "./ProjectMark.astro";

interface Props {
  /** The address of the page's Markdown twin, if it has one. */
  markdownPath?: string | undefined;
}

const { markdownPath } = Astro.props;
const { project } = SITE;
const hub = SITE.isHub ? "/" : (STEADING.site as string);
const onHub = (path: string) => (SITE.isHub ? path : new URL(path, hub).href);
const projectHref = (other: Project) => other.site ?? `${hub}#${other.id}`;
// The first lines of the navigation: pages, and each folder by its own page.
const { nav } = await getPages();
const pages = nav.flatMap((section) => section.items).slice(0, 8);
---

<footer class="site-footer">
  <div class="wrap columns">
    <div class="about">
      <a href="/" class="wordmark">
        <ProjectMark glyph={project.glyph} size={32} />
        {project.name}
      </a>
      <p>{SITE.isHub ? project.job : `${project.what}.`}</p>
      <p>
        Open source, built in the open. <a href={SITE.license.url}>{SITE.license.name}</a> licensed.
      </p>
    </div>

    <nav aria-labelledby="footer-projects">
      <h2 id="footer-projects">Projects</h2>
      <ul>
        {
          PROJECTS.map((other) => (
            <li>
              <a href={projectHref(other)} aria-current={other.id === project.id ? "page" : undefined}>
                {other.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      !SITE.isHub && (
        <nav aria-labelledby="footer-site">
          <h2 id="footer-site">{project.name}</h2>
          <ul>
            <li>
              <a href="/">Front page</a>
            </li>
            {pages.map((item) => (
              <li>
                <a href={item.doc.path}>{item.label}</a>
              </li>
            ))}
            {project.repo && (
              <li>
                <a href={project.repo}>Source on GitHub</a>
              </li>
            )}
          </ul>
        </nav>
      )
    }

    <nav aria-labelledby="footer-steading">
      <h2 id="footer-steading">Steading</h2>
      <ul>
        <li><a href={hub}>Front page</a></li>
        <li><a href={`${hub}#projects`}>Projects, by the problem they fix</a></li>
        {
          HUB_PAGES.map((page) => (
            <li>
              <a href={onHub(page.path)}>{page.label}</a>
            </li>
          ))
        }
        <li><a href="https://github.com/steading-ai">Steading on GitHub</a></li>
        <li><a href={SITE.chat}>Discord</a></li>
      </ul>
    </nav>

    <nav aria-labelledby="footer-agents">
      <h2 id="footer-agents">For agents</h2>
      <ul>
        {
          markdownPath && (
            <li>
              <a href={markdownPath}>This page as Markdown</a>
            </li>
          )
        }
        <li><a href="/llms.txt">llms.txt</a>, the map of this site</li>
        <li><a href="/llms-full.txt">llms-full.txt</a>, every page in one file</li>
        <li><a href="/sitemap.xml">Sitemap</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 3.5rem 4rem;
    border-top: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.9rem;
  }
  .columns {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .about {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    grid-column: 1 / -1;
    max-width: 22rem;
    color: var(--muted);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  h2 {
    margin-bottom: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
  }
  li {
    color: var(--muted);
  }
  li + li {
    margin-top: 0.5rem;
  }
  nav a {
    color: var(--ink);
    text-decoration-color: transparent;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    text-decoration-color: var(--accent);
  }
  @media (min-width: 40rem) {
    .columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .columns {
      grid-template-columns: minmax(0, 1.6fr) repeat(auto-fit, minmax(9rem, 1fr));
      grid-auto-flow: column;
      grid-auto-columns: minmax(9rem, 1fr);
    }
    .about {
      grid-column: auto;
    }
  }
</style>
