---
// stead.ing's front page: where software is going and how to start today,
// then which project fixes your problem, how they fit together, that it's
// real, and how to build it with us. The hero's words come from
// content/site.yaml.
import type { Landing } from "../lib/schema.ts";
import { SITE } from "../site.ts";
import FlowMap from "./motifs/FlowMap.astro";
import Steps from "./motifs/Steps.astro";
import Timeline from "./motifs/Timeline.astro";
import ProjectIndex from "./ProjectIndex.astro";
import PromptBox from "./PromptBox.astro";

interface Props {
  landing: Landing;
}

const { landing } = Astro.props;
const sentences = landing.headline.split(/(?<=\.)\s+/);
---

<section class="hero wrap">
  <h1 class="display">{sentences.map((sentence) => <span>{sentence} </span>)}</h1>
  <p class="lead measure">{landing.summary}</p>
  <PromptBox prompt={landing.prompt} />
  <p class="facts">
    Paste the prompt into your agent, or <a href="#projects">start with the project for your problem</a>.
  </p>
  <Timeline id="hero" view={{ pxPerHour: 130, backlog: false, threads: true, speed: 1 / 10, tone: "muted", compact: true }} />
</section>

<section class="band band-surface" aria-labelledby="why">
  <div class="wrap">
    <h2 id="why" class="display-2">You've got more ideas than hours.</h2>
    <p class="mt-6 measure">
      You pay for a model subscription (or <em>four</em>) and either max it out or barely use it. Not for lack of ideas, but
      because babysitting agents eats up most of your time.
    </p>
    <div class="day">
      <Steps variant="turns" />
    </div>
    <p class="monday"><em>Every morning feels like Monday brain.</em></p>
    <p class="same-wall"><a href="/history/">We hit the same wall.</a></p>
  </div>
</section>

<section class="band" aria-labelledby="idea">
  <div class="wrap">
    <h2 id="idea" class="display-2">A platform you can take apart</h2>
    <p class="subtitle">Great on its own, better together</p>
    <p class="lead measure mt-4">
      Everyone else is building one big system for you to move into. Steading is a platform too, but it's made of projects,
      each built to do one job well, each with an open interface. If you have a better idea for a project, swap in your own;
      the rest keeps working.
    </p>
    <div class="mt-10">
      <FlowMap id="map" />
    </div>
  </div>
</section>

<section class="band band-surface" aria-labelledby="projects">
  <div class="wrap">
    <h2 id="projects" class="display-2">What's your biggest bottleneck?</h2>
    <p class="lead measure mt-4">
      Start with what's slowing you down today. Every project works on its own, and they get better <em>together</em>.
    </p>
    <div class="mt-10">
      <ProjectIndex />
    </div>
  </div>
</section>

<section class="band" aria-labelledby="beliefs">
  <div class="wrap">
    <h2 id="beliefs" class="display-2">What we believe</h2>
    <dl class="beliefs mt-10">
      <div>
        <dt>You decide what. Agents do the rest.</dt>
        <dd>Nobody should have to sit in a chat window for work to move.</dd>
      </div>
      <div>
        <dt>Proof, not promises.</dt>
        <dd>"Done" means a program checked it.</dd>
      </div>
      <div>
        <dt>Real fences, not polite requests.</dt>
        <dd>
          What an agent can touch is limited by the operating system, the network, or a virtual machine, not by a sentence in a
          prompt.
        </dd>
      </div>
      <div>
        <dt>Code over prompts.</dt>
        <dd>A model is called only where judgment is actually needed.</dd>
      </div>
      <div>
        <dt>Yours.</dt>
        <dd>Your hardware, your database, your rules.</dd>
      </div>
      <div>
        <dt>Fork it.</dt>
        <dd>Take any project and make it your own. Send back what's worth sharing.</dd>
      </div>
    </dl>
  </div>
</section>

<section class="band band-surface" aria-labelledby="join">
  <div class="wrap">
    <h2 id="join" class="display">Don't build it all on your own!</h2>
    <p class="lead measure mt-6">
      Everyone is building their own version of this and hitting the same walls. Build it with a community instead. Come
      hang out on <a href={SITE.chat}>Discord</a>, pick up an open task, ask questions, or show us what you've made!
    </p>
    <p class="mt-6 flex flex-wrap gap-x-8 gap-y-2">
      <a href={SITE.chat}>Join the Discord</a>
      <a href="/how-we-work/">How we work, and how a project joins</a>
      <a href="https://github.com/steading-ai">Steading on GitHub</a>
    </p>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(1.25rem, 4vw, 2.5rem) clamp(2.5rem, 6vw, 4rem);
  }
  /* A grid item is as wide as its widest content unless told otherwise. The day strip is another component's element, so the rule has to reach past this one's own. */
  .hero > :global(*) {
    min-width: 0;
  }
  .display span {
    display: block;
  }
  /* The first step is the point of the page: it takes the full width, at a size that says so. */
  .hero :global(.prompt) {
    padding: 1.1rem 1.25rem;
  }
  .hero :global(.prompt pre) {
    font-size: 1.05rem;
  }
  .facts {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .hero :global(.timeline) {
    margin-top: 1rem;
  }
  @media (min-width: 72rem) {
    /* The headline on one line across the page. */
    .display span {
      display: inline;
    }
  }

  .subtitle {
    margin-top: 0.5rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 1.15rem;
  }

  /* The day in five steps, across the page. */
  .day {
    max-width: 56rem;
  }
  .monday {
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    line-height: 1.25;
    text-wrap: balance;
  }
  /* The way on from here: how Steading came out of the same day. */
  .same-wall {
    margin-top: 0.75rem;
    font-size: 1.15rem;
  }

  .beliefs {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .beliefs > div {
    display: grid;
    gap: 0.25rem 3rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .beliefs dt {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 600;
  }
  @media (min-width: 60rem) {
    .beliefs > div {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }
</style>
