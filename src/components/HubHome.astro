---
// stead.ing's front page: where software is going and how to start today,
// what is in the reader's way, how the projects fit together, which one to
// start with, what we believe, and how to build it with us. The hero's words come from
// content/site.yaml.
import type { Landing } from "../lib/schema.ts";
import { projectById, whereabouts } from "../projects.ts";
import Beliefs from "./Beliefs.astro";
import GitHubMark from "./GitHubMark.astro";
import Hero from "./Hero.astro";
import JoinIn from "./JoinIn.astro";
import Platform from "./Platform.astro";
import StartWithOne from "./StartWithOne.astro";
import Steps from "./motifs/Steps.astro";
import Timeline from "./motifs/Timeline.astro";
import ProjectMark from "./ProjectMark.astro";

interface Props {
  landing: Landing & { prompt: string };
}

const { landing } = Astro.props;
const SOURCE = "https://github.com/steading-ai";
// The projects that have a lane in the timeline, in the order work moves through them.
const stack = ["skift", "mill", "almanac", "thicket", "croft", "knowledge"].map(projectById);
---

<Hero headline={landing.headline} summary={landing.summary} prompt={landing.prompt}>
  <Fragment slot="before-prompt">
    <div class="source">
      <a class="button-primary" href={SOURCE}>
        <GitHubMark size={20} />
        Browse source on GitHub
        <span aria-hidden="true">↗</span>
      </a>
      <p class="license">Open source · ISC · DCO</p>
    </div>
    <section class="part" aria-labelledby="stack">
      <div class="part-head">
        <h2 id="stack" class="eyebrow">The stack at a glance</h2>
        <p class="aside">Useful alone. Better together.</p>
      </div>
      <ul class="stack">
        {
          stack.map((project) => (
            <li class={`p-${project.id}`}>
              <ProjectMark glyph={project.glyph} size={32} bare />
              <p>
                <a href={whereabouts(project, "/")}>{project.name}</a>
                <span>{project.kind}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </Fragment>
  <section class="part in-action" aria-labelledby="in-action">
    <Timeline id="hero" view={{ pxPerHour: 130, backlog: false, threads: true, speed: 1 / 10, tone: "muted", compact: true }}>
      <h2 id="in-action" class="eyebrow">See it in action</h2>
    </Timeline>
  </section>
</Hero>

<section class="why band-surface" aria-labelledby="why">
  <div class="wrap">
    <h2 id="why" class="display-2">You've got more ideas than hours.</h2>
    <p class="told">
      You start an agent, give it a goal, and move on to something else. Then you come back to find it stuck, waiting for the
      one thing only you can do.
    </p>
    <Steps />
    <div class="bottleneck">
      <p class="punch">The bottleneck is <em>you.</em></p>
      <p class="by-design">Not by choice. By design.</p>
      <p class="same-wall">
        <a href="/history/">We hit the same wall. <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </div>
</section>

<Platform />

<StartWithOne />

<Beliefs />

<JoinIn />

<style>
  /*
   * The hero, top to bottom: the source, the stack, the prompt, and the day.
   * Each part after the first opens on a rule and a small label, so the whole
   * of it reads in one screen.
   */
  .eyebrow,
  :global(.hero [data-prompt-box] figcaption) {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .part,
  :global(.hero [data-prompt-box]) {
    padding-top: var(--hero-gap);
    border-top: 1px solid var(--line);
  }
  .part-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 2rem;
  }
  .aside {
    color: var(--muted);
    font-size: 1.05rem;
  }

  .source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 0.5rem;
  }
  .source .button-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.3rem;
    font-size: 1.05rem;
  }
  .license {
    color: var(--muted);
  }
  @media (max-width: 29.99rem) {
    .source .button-primary {
      font-size: 0.95rem;
    }
  }
  @media (min-width: 40rem) {
    .license {
      padding-left: 1.5rem;
      border-left: 1px solid var(--line);
    }
  }

  /* Six cards: one row where they fit, else rows of three or two, never a row with a gap in it. */
  .stack {
    display: grid;
    gap: 0.75rem;
    margin-top: calc(var(--hero-gap) * 0.8);
  }
  @media (min-width: 30rem) {
    .stack {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 48rem) {
    .stack {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 80rem) {
    .stack {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  /* A card is one link: the project's name, stretched over the whole card. */
  .stack li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--surface);
  }
  .stack p {
    line-height: 1.3;
  }
  .stack li:hover {
    border-color: var(--accent);
  }
  .stack a {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 600;
    text-decoration: none;
  }
  .stack a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .stack li:hover a {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .stack span {
    display: block;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.3;
  }

  /* The day: its label on the strip's top line, beside Pause, and its picture in a frame. */
  .in-action :global(.timeline .bar) {
    align-items: center;
    margin-bottom: calc(var(--hero-gap) * 0.6);
  }
  .in-action :global(.timeline .stage) {
    padding: calc(var(--hero-gap) * 0.5) 1rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
  }

  /* The day in five steps, across the page. */
  /*
   * Between the hero and the map: the reader's own day, and what is wrong with
   * it, said in less than a screen so the answer below is still in sight.
   */
  .why {
    padding-block: clamp(1.75rem, 4.5vh, 2.75rem);
  }
  .told {
    max-width: 74ch;
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.5;
  }
  .why :global(.steps) {
    margin-top: 1.75rem;
  }
  .bottleneck {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 2.5rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .punch {
    font-family: var(--font-mono);
    font-size: clamp(1.6rem, 3.6vw, 2.4rem);
    font-style: italic;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }
  .punch em {
    color: var(--ember);
  }
  .by-design {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 1.05rem;
  }
  /* The way on from here: how Steading came out of the same day. */
  .same-wall {
    font-size: 1.1rem;
  }
  @media (min-width: 60rem) {
    .by-design {
      align-self: stretch;
      display: flex;
      align-items: center;
      padding-left: 2.5rem;
      border-left: 1px solid var(--line);
    }
    .same-wall {
      margin-left: auto;
    }
  }
</style>
