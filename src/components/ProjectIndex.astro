---
// The hub's router: every row starts with a problem in the words of someone
// who has it, and ends at the project that answers it. Rows are grouped by how
// far along each project is, so "can I use it today?" is answered by where a
// row sits.
import { PROJECTS, type Project, type Status, STATUS_LABEL } from "../projects.ts";
import ProjectMark from "./ProjectMark.astro";

const ORDER: Status[] = ["running", "early", "design"];
const NOTE: Record<Status, string> = {
  running: "Used every day to build Steading itself.",
  early: "Working, with rough edges.",
  design: "Not built yet. Shown so you know where this is going.",
};
/** Where a row leads: the project's site, or its source while it has none. Some projects have neither yet. */
const destination = (project: Project) => project.site ?? project.repo;
const groups = ORDER.map((status) => ({ status, projects: PROJECTS.filter((project) => project.status === status) }));
---

{
  groups.map(({ status, projects }) => (
    <section class="group" aria-labelledby={`status-${status}`}>
      <header>
        <h3 id={`status-${status}`}>{STATUS_LABEL[status]}</h3>
        <p>{NOTE[status]}</p>
      </header>
      <ul>
        {projects.map((project) => (
          <li id={project.id} class:list={[`p-${project.id}`, { linked: destination(project) }]}>
            <p class="pain">
              “{project.pain}”{project.measured && <span class="measured"> {project.measured}</span>}
            </p>
            <div class="answer">
              <ProjectMark glyph={project.glyph} size={40} bare />
              <div>
                <p class="name">
                  {destination(project) ? <a href={destination(project)}>{project.name}</a> : project.name}
                  <span class="job">{project.job}</span>
                </p>
                <p class="blurb">{project.blurb}</p>
                {destination(project) && <p class="where">{project.site ? new URL(project.site).host : "Source on GitHub"}</p>}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))
}

<style>
  .group {
    display: grid;
    gap: 0.5rem 3rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }
  header h3 {
    font-size: 1rem;
  }
  header p {
    color: var(--muted);
    font-size: 0.9rem;
  }
  li {
    display: grid;
    gap: 0.75rem 2.5rem;
    padding-block: 1.1rem;
    scroll-margin-top: 1rem;
  }
  /* Arriving from the Projects menu: say which row was meant. */
  li:target .name {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
  }
  li + li {
    border-top: 1px solid var(--line);
  }
  .pain {
    font-size: 1.25rem;
    line-height: 1.35;
    text-wrap: balance;
  }
  .measured {
    display: block;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .answer {
    display: flex;
    gap: 1rem;
  }
  .name {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 600;
  }
  .job {
    margin-left: 0.75rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 400;
  }
  .where {
    margin-top: 0.25rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  /* A row that leads somewhere is one link: the project's name, stretched over the whole row. */
  .linked {
    position: relative;
  }
  .linked .name a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .linked:hover {
    background: var(--ground);
    box-shadow: -1rem 0 0 var(--ground), 1rem 0 0 var(--ground);
  }
  .linked:hover .where {
    color: var(--ink);
  }
  @media (min-width: 48rem) {
    li {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: start;
    }
  }
  @media (min-width: 64rem) {
    .group {
      grid-template-columns: 13rem minmax(0, 1fr);
    }
    li:first-child {
      padding-top: 0;
    }
  }
</style>
