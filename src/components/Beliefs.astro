---
// What Steading holds to, as six short claims, each with a small drawing, in
// rows of three on a wide screen. Lines between them, never around them.
import { ICONS, type IconName } from "../lib/icons.ts";

const BELIEFS: { icon: IconName; title: string; body: string }[] = [
  { icon: "person", title: "You decide. Agents do the rest.", body: "Nobody should have to sit in a chat window for work to move." },
  { icon: "checked", title: "Proof, not promises.", body: "“Done” means a program checked it." },
  { icon: "layers", title: "Real fences, not polite requests.", body: "What an agent can touch is limited by the operating system, the network, or a virtual machine." },
  { icon: "code", title: "Code over prompts.", body: "A model is called only where judgment is actually needed." },
  { icon: "server", title: "Yours.", body: "Your hardware, your database, your rules." },
  { icon: "fork", title: "Fork it.", body: "Take any project and make it your own. Send back what's worth sharing." },
];
---

<section class="beliefs" aria-labelledby="beliefs">
  <div class="wrap">
    <h2 id="beliefs" class="display-2">What we believe.</h2>
    <div class="frame">
      <ul>
        {
          BELIEFS.map((belief) => (
            <li>
              <svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[belief.icon]} />
              <h3>{belief.title}</h3>
              <p>{belief.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .beliefs {
    --pad: 2rem;
    padding-block: clamp(2rem, 5vh, 3.25rem);
  }
  /*
   * Each claim draws the rule to its left and the rule above it. The frame
   * clips the ones on the outside edges, so only the lines between claims
   * show, however many fit in a row.
   */
  .frame {
    margin-top: 1.5rem;
    overflow: hidden;
  }
  ul {
    display: grid;
    margin: -1px calc(var(--pad) * -1) 0;
  }
  @media (min-width: 40rem) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  li {
    position: relative;
    padding: 1.6rem var(--pad);
  }
  li::before {
    content: "";
    position: absolute;
    inset-block: 1.6rem;
    left: 0;
    border-left: 1px solid var(--line);
  }
  li::after {
    content: "";
    position: absolute;
    top: 0;
    inset-inline: 0;
    border-top: 1px solid var(--line);
  }
  svg {
    width: 2.75rem;
    height: 2.75rem;
  }
  h3 {
    margin-top: 0.9rem;
    font-size: 1.2rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  p {
    max-width: 36ch;
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.5;
  }
</style>
