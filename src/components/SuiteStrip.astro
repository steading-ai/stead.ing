---
// The family, on every site: Steading and each of its projects. A project links
// once it has a site of its own; until then it is listed by name with its status.
import { PROJECTS, STATUS_LABEL, STEADING } from "../projects.ts";
import { SITE } from "../site.ts";
import ProjectMark from "./ProjectMark.astro";

const current = SITE.project.id;
---

<nav aria-label="Steading projects" class="strip">
  <ul class="wrap">
    <li class="p-steading">
      <a href={STEADING.site} aria-current={current === STEADING.id ? "page" : undefined} class="home">
        <ProjectMark glyph={STEADING.glyph} size={16} />
        steading
      </a>
    </li>
    {
      PROJECTS.map((project) => (
        <li class={`p-${project.id}`}>
          {project.site ? (
            <a href={project.site} aria-current={current === project.id ? "page" : undefined}>
              {project.name}
            </a>
          ) : (
            <span>
              {project.name}
              <span class="sr-only">, {STATUS_LABEL[project.status].toLowerCase()}, no site yet</span>
            </span>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .strip {
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    column-gap: 1.5rem;
  }
  li {
    display: flex;
    flex-shrink: 0;
    /* Keeps each item's screen-reader text inside the row, so it scrolls with it instead of widening the page. */
    position: relative;
  }
  /* On a phone the family is one row that scrolls, so it never pushes the page's point down the screen. */
  @media (max-width: 47.99rem) {
    ul {
      flex-wrap: nowrap;
      overflow-x: auto;
    }
  }
  a,
  li > span {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    border-bottom: 2px solid transparent;
  }
  li > span {
    color: var(--muted);
  }
  a {
    text-decoration: none;
  }
  a:hover {
    border-bottom-color: var(--accent);
  }
  .home {
    font-weight: 600;
  }
  /* The site you are on: a square of its color, and its color underneath. */
  a[aria-current="page"] {
    border-bottom-color: var(--accent);
    font-weight: 600;
  }
  a[aria-current="page"]:not(.home)::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
  }
</style>
