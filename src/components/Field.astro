---
// The tagline, drawn: one light in a courtyard, in a field of a thousand
// cells. The hub's field is lit in every other project's color; a project's
// site draws the same picture in its own color, with its own mark in the yard.
import { field, groups, SIZE, YARD_BOX } from "../lib/field.ts";
import { markBody } from "../lib/mark.ts";
import { PROJECTS, type Project } from "../projects.ts";

interface Props {
  project: Project;
  /** Draw the field in every project's color instead of only this one's. */
  everyProject?: boolean;
}

const { project, everyProject = false } = Astro.props;
// Ember is the one light, so the console, which shares it, stays out of the field.
const palette = everyProject
  ? PROJECTS.filter((other) => other.color.dark !== project.color.dark).map((other) => other.id)
  : [project.id];
const drawn = groups(field(palette, everyProject ? 0.24 : 0.26));
const center = YARD_BOX.x + YARD_BOX.size / 2;
const label = everyProject
  ? "A courtyard with one ember light, in a field of a thousand small squares lit in the colors of Steading's projects."
  : `The ${project.name} mark in its courtyard, in a field of a thousand small squares.`;
---

<svg class="field" viewBox={`0 0 ${SIZE} ${SIZE}`} role="img" aria-label={label}>
  <defs>
    <radialGradient id="field-glow">
      <stop offset="0" class="glow-start"></stop>
      <stop offset="1" class="glow-end"></stop>
    </radialGradient>
  </defs>
  {
    drawn.map((group) => (
      <path
        class:list={["cells", group.color ? `lit p-${group.color}` : "quiet"]}
        style={`--ring:${group.ring}`}
        d={group.d}
      />
    ))
  }
  <circle class="glow" cx={center} cy={center - 3} r={YARD_BOX.size * 0.46} fill="url(#field-glow)"></circle>
  <svg
    class="project-mark"
    x={YARD_BOX.x}
    y={YARD_BOX.y}
    width={YARD_BOX.size}
    height={YARD_BOX.size}
    viewBox="0 0 120 120"
    set:html={markBody(project.glyph)}
  />
</svg>

<style>
  .field {
    display: block;
    width: 100%;
    height: auto;
    color: var(--ink);
  }
  /* The light reaches the nearest ring first, once, when the page loads. */
  .cells {
    animation: reach 0.5s ease-out both;
    animation-delay: calc(var(--ring) * 70ms + 150ms);
  }
  .quiet {
    fill: currentColor;
    opacity: 0.16;
  }
  .lit {
    fill: var(--accent);
    opacity: 0.92;
  }
  .glow-start {
    stop-color: var(--accent);
    stop-opacity: 0.4;
  }
  .glow-end {
    stop-color: var(--accent);
    stop-opacity: 0;
  }
  @media (prefers-color-scheme: light) {
    .glow-start {
      stop-opacity: 0.22;
    }
  }
  @keyframes reach {
    from {
      opacity: 0.04;
    }
  }
</style>
