---
// A project's courtyard mark. The ring is drawn in the text color and the
// light in the nearest --accent (global.css), so the mark follows whatever it
// sits in.
import { markBody } from "../lib/mark.ts";
import type { Glyph } from "../projects.ts";

interface Props {
  glyph: Glyph;
  size?: number;
  /** Accessible name. Leave it out when the name is written beside the mark. */
  label?: string;
}

const { glyph, size = 40, label } = Astro.props;
---

<svg
  class="project-mark"
  width={size}
  height={size}
  viewBox="0 0 120 120"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  set:html={markBody(glyph)}
/>
