---
// Variation 2. Left to right: you and the world's events come in, twenty lanes
// of agents hand the work along, and merged changes stack up at the far side.
import { PITCH, square } from "../../lib/field.ts";
import { AGENTS_X, arrivals, lanes, OUT_X, WIDE, WIDE_COLS } from "../../lib/heroes.ts";
import { markBody } from "../../lib/mark.ts";
import { PROJECTS, STEADING } from "../../projects.ts";

const palette = PROJECTS.filter((project) => project.color.dark !== STEADING.color.dark).map((project) => project.id);
const drawn = lanes(palette);
const incoming = arrivals();
const width = WIDE_COLS * PITCH;
const height = WIDE.rows * PITCH;
let agents = "";
for (let row = 0; row < WIDE.rows; row++) for (let col = 0; col < WIDE.agents; col++) agents += square(AGENTS_X + col, row);
const TRAIL = [1, 0.7, 0.46, 0.28, 0.14];
const travel = (WIDE.agents + TRAIL.length) * PITCH;
const yard = WIDE.source * PITCH;
---

<svg
  viewBox={`0 0 ${width} ${height}`}
  role="img"
  aria-label="On the left, a courtyard with one ember light and a few arriving squares. Across the middle, a thousand small squares in twenty rows, with light moving along each row from left to right. On the right, solid squares stack up as changes merge."
>
  <defs>
    <clipPath id="stream-agents">
      <rect x={AGENTS_X * PITCH} y="0" width={WIDE.agents * PITCH} height={height}></rect>
    </clipPath>
  </defs>
  <svg class="project-mark p-steading" x="0" y={(height - yard) / 2} width={yard} height={yard} viewBox="0 0 120 120" set:html={markBody("console")} />
  {incoming.map((event) => <path class="arrival" style={`--at:${event.at.toFixed(2)}s`} d={square(event.x, event.y)} />)}
  <path class="quiet" d={agents}></path>
  <g clip-path="url(#stream-agents)">
    {
      drawn.map((lane) => (
        <g class={`comet p-${lane.color}`} style={`--dur:${lane.duration.toFixed(2)}s;--delay:-${lane.offset.toFixed(2)}s;--travel:${travel}px`}>
          {TRAIL.map((opacity, index) => (
            <path opacity={opacity} d={square(AGENTS_X - 1 - index, lane.row)} />
          ))}
        </g>
      ))
    }
  </g>
  {
    drawn.map((lane) =>
      lane.shipped.map((at, index) => <path class="shipped" style={`--at:${at.toFixed(2)}s`} d={square(OUT_X + index, lane.row)} />),
    )
  }
</svg>

<style>
  .quiet {
    fill: currentColor;
    opacity: 0.14;
  }
  .comet {
    fill: var(--accent);
    animation: run var(--dur) steps(55) infinite;
    animation-delay: var(--delay);
  }
  .arrival {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    animation: arrive 6s ease-in-out infinite;
    animation-delay: var(--at);
  }
  .shipped {
    fill: var(--ink);
    animation: ship 0.5s ease-out both;
    animation-delay: var(--at);
  }
  @keyframes run {
    to {
      transform: translateX(var(--travel));
    }
  }
  @keyframes arrive {
    0%,
    100% {
      opacity: 0.25;
    }
    12% {
      opacity: 1;
    }
    45% {
      opacity: 0.25;
    }
  }
  @keyframes ship {
    from {
      opacity: 0;
    }
  }
</style>
