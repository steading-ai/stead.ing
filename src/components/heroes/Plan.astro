---
// Variation 3. A plan resolving. A task becomes ready when what it depends on
// is done, an agent works it, and it unlocks the next, until the change ships.
// Then the next plan starts.
import { CELL, PITCH, square } from "../../lib/field.ts";
import { AGENTS_X, OUT_X, plan, PLAN_LAYERS, WIDE, WIDE_COLS } from "../../lib/heroes.ts";
import { markBody } from "../../lib/mark.ts";
import { PROJECTS, STEADING } from "../../projects.ts";

const palette = PROJECTS.filter((project) => project.color.dark !== STEADING.color.dark).map((project) => project.id);
const { nodes, edges } = plan(palette);
const width = WIDE_COLS * PITCH;
const height = WIDE.rows * PITCH;
let agents = "";
for (let row = 0; row < WIDE.rows; row++) for (let col = 0; col < WIDE.agents; col++) agents += square(AGENTS_X + col, row);

const inset = (PITCH - CELL) / 2;
const NODE = PITCH + CELL;
const at = (point: { x: number; y: number }) => ({ x: (AGENTS_X + point.x) * PITCH, y: point.y * PITCH });
const yard = WIDE.source * PITCH;
const middle = height / 2;
const first = nodes.filter((node) => node.layer === 0);
const last = nodes.filter((node) => node.layer === PLAN_LAYERS.length - 1);
const out = { x: (OUT_X + 1) * PITCH, y: middle - 30, size: 60 };

// One loop of the plan, as shares of its length: each layer is worked a beat after the one before.
const LOOP = 14;
const share = (seconds: number) => ((seconds / LOOP) * 100).toFixed(2);
const starts = (layer: number) => 0.6 + layer * 1.35;
const ends = (layer: number) => starts(layer) + 1.15;
const shipsAt = ends(PLAN_LAYERS.length - 1) + 0.3;
const keyframes = [
  ...PLAN_LAYERS.flatMap((_, layer) => [
    `@keyframes plan-work-${layer}{0%,${share(starts(layer))}%{opacity:0}${share(starts(layer) + 0.2)}%,${share(ends(layer))}%{opacity:1}${share(ends(layer) + 0.25)}%,100%{opacity:0}}`,
    `@keyframes plan-done-${layer}{0%,${share(ends(layer))}%{opacity:0}${share(ends(layer) + 0.25)}%,88%{opacity:1}94%,100%{opacity:0}}`,
    `@keyframes plan-edge-${layer}{0%,${share(ends(layer))}%{opacity:.2}${share(ends(layer) + 0.3)}%,88%{opacity:.85}94%,100%{opacity:.2}}`,
  ]),
  `@keyframes plan-ship{0%,${share(shipsAt)}%{opacity:0}${share(shipsAt + 0.35)}%,88%{opacity:1}94%,100%{opacity:0}}`,
  `@keyframes plan-edge-last{0%,${share(shipsAt - 0.3)}%{opacity:.2}${share(shipsAt)}%,88%{opacity:.85}94%,100%{opacity:.2}}`,
].join("");
const loop = (name: string) => `animation:${name} ${LOOP}s linear infinite`;
---

<style is:inline set:html={keyframes}></style>

<svg
  viewBox={`0 0 ${width} ${height}`}
  role="img"
  aria-label="A plan drawn across a field of a thousand small squares: tasks joined by lines, running from a courtyard with one ember light on the left to a single ember square on the right. Tasks light up and turn solid from left to right as each one finishes and unlocks the next."
>
  <path class="quiet" d={agents}></path>

  {first.map((node) => <line class="edge" style="opacity:.85" x1={yard} y1={middle} x2={at(node).x + PITCH} y2={at(node).y + PITCH} />)}
  {
    edges.map((edge) => (
      <line class="edge" style={loop(`plan-edge-${edge.layer}`)} x1={at(edge.from).x} y1={at(edge.from).y} x2={at(edge.to).x} y2={at(edge.to).y} />
    ))
  }
  {last.map((node) => <line class="edge" style={loop("plan-edge-last")} x1={at(node).x + PITCH} y1={at(node).y + PITCH} x2={out.x} y2={middle} />)}

  {
    nodes.map((node) => (
      <g class={`p-${node.color}`}>
        <rect class="task" x={at(node).x + inset} y={at(node).y + inset} width={NODE} height={NODE} />
        <rect class="work" style={loop(`plan-work-${node.layer}`)} x={at(node).x + inset} y={at(node).y + inset} width={NODE} height={NODE} />
        <rect class="done" style={loop(`plan-done-${node.layer}`)} x={at(node).x + inset} y={at(node).y + inset} width={NODE} height={NODE} />
      </g>
    ))
  }

  <svg class="project-mark p-steading" x="0" y={middle - yard / 2} width={yard} height={yard} viewBox="0 0 120 120" set:html={markBody("console")} />
  <rect class="result" x={out.x} y={out.y} width={out.size} height={out.size}></rect>
  <rect class="shipped" style={loop("plan-ship")} x={out.x + 14} y={out.y + 14} width={out.size - 28} height={out.size - 28}></rect>
</svg>

<style>
  .quiet {
    fill: currentColor;
    opacity: 0.12;
  }
  .edge {
    stroke: currentColor;
    stroke-width: 1.1;
    opacity: 0.85;
  }
  /* A task waiting its turn: an outline on the ground color, so the field doesn't show through. */
  .task {
    fill: var(--ground);
    stroke: currentColor;
    stroke-width: 1.2;
  }
  .work {
    fill: var(--accent);
    opacity: 0;
  }
  .done {
    fill: var(--ink);
  }
  .result {
    fill: var(--ground);
    stroke: var(--ember);
    stroke-width: 2.5;
  }
  .shipped {
    fill: var(--ember);
  }
</style>
