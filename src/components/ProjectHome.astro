---
// A project's front page, written entirely by its site.yaml. Every project's
// site has the same skeleton: what it does and the first step, where to start,
// what it does, what it is not, and what it works better with.
import type { NavGroup } from "../lib/docs.ts";
import { inline } from "../lib/markdown.ts";
import type { Landing } from "../lib/schema.ts";
import { projectById, STATUS_LABEL } from "../projects.ts";
import { SITE } from "../site.ts";
import Field from "./Field.astro";
import ProjectMark from "./ProjectMark.astro";
import PromptBox from "./PromptBox.astro";

interface Props {
  landing: Landing;
  nav: NavGroup[];
}

const { landing, nav } = Astro.props;
const { project } = SITE;
const pairs = landing.pairs.map((pair) => ({ ...pair, project: projectById(pair.project) }));
const firstDoc = nav[0]?.docs[0];
---

<section class="hero wrap">
  <div class="words">
    <h1 class="display-2">{landing.headline}</h1>
    <p class="lead measure">{landing.summary}</p>
    <PromptBox prompt={landing.prompt} />
    {
      landing.install && (
        <div>
          <pre class="install" tabindex="0" aria-label="Install command"><code>{landing.install.command}</code></pre>
          {landing.install.note && <p class="mt-2 text-sm text-muted" set:html={inline(landing.install.note)} />}
        </div>
      )
    }
    <ul class="facts">
      <li>{STATUS_LABEL[project.status]}</li>
      {landing.facts.map((fact) => <li>{fact}</li>)}
    </ul>
    {firstDoc && <p><a href={firstDoc.path}>Start with: {firstDoc.title}</a></p>}
  </div>
  <div class="picture">
    <Field project={project} />
  </div>
</section>

{
  landing.starts.length > 0 && (
    <section class="band band-surface" aria-labelledby="starts">
      <div class="wrap">
        <h2 id="starts" class="display-2">Pick your starting point</h2>
        <ul class="starts mt-10">
          {landing.starts.map((start) => (
            <li>
              <h3 class="title">{start.title}</h3>
              <p class="mt-3" set:html={inline(start.body)} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

{
  landing.features.length > 0 && (
    <section class="band" aria-labelledby="features">
      <div class="wrap">
        <h2 id="features" class="display-2">What it does</h2>
        <dl class="pairs-list mt-10">
          {landing.features.map((feature) => (
            <div>
              <dt>{feature.title}</dt>
              <dd set:html={inline(feature.body)} />
            </div>
          ))}
        </dl>
      </div>
    </section>
  )
}

{
  landing.not.length > 0 && (
    <section class="band band-surface" aria-labelledby="not">
      <div class="wrap">
        <h2 id="not" class="display-2">What {project.name} is not</h2>
        <dl class="pairs-list mt-10">
          {landing.not.map((entry) => (
            <div>
              <dt>{entry.title}</dt>
              <dd set:html={inline(entry.body)} />
            </div>
          ))}
        </dl>
        {landing.instead && <p class="lead measure mt-8" set:html={inline(landing.instead)} />}
      </div>
    </section>
  )
}

{
  pairs.length > 0 && (
    <section class="band" aria-labelledby="pairs">
      <div class="wrap">
        <h2 id="pairs" class="display-2">Works better with</h2>
        <ul class="together mt-10">
          {pairs.map((pair) => (
            <li class={`p-${pair.project.id}`}>
              <ProjectMark glyph={pair.project.glyph} size={40} bare />
              <p>
                <strong class="font-mono">
                  {pair.project.site ? <a href={pair.project.site}>{pair.project.name}</a> : pair.project.name}
                </strong>{" "}
                <span set:html={inline(pair.body)} />
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

{
  nav.length > 0 && (
    <section class="band band-surface" aria-labelledby="docs">
      <div class="wrap">
        <h2 id="docs" class="display-2">Docs</h2>
        <div class="docs mt-10">
          {nav.map((group) => (
            <div>
              {group.label && <h3 class="font-semibold">{group.label}</h3>}
              <ul class="mt-2 space-y-2">
                {group.docs.map((doc) => (
                  <li>
                    <a href={doc.path}>{doc.title}</a>
                    {doc.data.description && <span class="text-muted">: {doc.data.description}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(1.25rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  .words {
    display: grid;
    gap: 1.25rem;
    align-content: center;
  }
  .picture {
    width: 100%;
    max-width: 24rem;
    margin-inline: auto;
  }
  @media (min-width: 72rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 24rem;
      gap: 3.5rem;
      align-items: center;
    }
  }
  .install {
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .starts {
    display: grid;
    gap: 2rem 3rem;
  }
  .starts li {
    padding-top: 1.25rem;
    border-top: 3px solid var(--accent);
  }
  @media (min-width: 56rem) {
    .starts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .pairs-list {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .pairs-list > div {
    display: grid;
    gap: 0.25rem 3rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .pairs-list dt {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 600;
  }
  @media (min-width: 60rem) {
    .pairs-list > div {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .together {
    display: grid;
    gap: 1.5rem 3rem;
  }
  .together li {
    display: flex;
    gap: 1rem;
  }
  @media (min-width: 56rem) {
    .together {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .docs {
    display: grid;
    gap: 2rem 3rem;
  }
  @media (min-width: 56rem) {
    .docs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
