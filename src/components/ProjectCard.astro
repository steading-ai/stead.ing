---
// One project on the hub: its mark, its job, how far along it is, and a way in
// once there is one. The status is always written out, never color alone.
import { type Project, STATUS_LABEL } from "../projects.ts";
import ProjectMark from "./ProjectMark.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const host = project.site ? new URL(project.site).host : undefined;
---

<li class:list={[`p-${project.id}`, "flex flex-col gap-3 rounded-lg border bg-surface p-4", project.status === "design" ? "border-dashed border-muted" : "border-line"]}>
  <div class="flex items-center gap-3">
    <ProjectMark glyph={project.glyph} size={40} />
    <div>
      <h3 class="text-lg font-semibold">{project.name}</h3>
      <p class="text-sm text-muted">{project.job}</p>
    </div>
  </div>
  <p class="grow">{project.blurb}</p>
  <p class="flex flex-wrap items-center justify-between gap-2 font-mono text-sm">
    <span class="rounded border border-line px-2 py-0.5">{STATUS_LABEL[project.status]}</span>
    {project.site && <a href={project.site}>{host}</a>}
    {!project.site && project.repo && <a href={project.repo}>Source<span class="sr-only"> for {project.name}</span></a>}
  </p>
</li>
